# Copy this file to .env and fill in your values.
# Never commit your actual .env file to version control.

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string.
# Local:  mongodb://localhost:27017/speechflow
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/speechflow
MONGODB_URI=mongodb://localhost:27017/speechflow

# ─── Authentication ────────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens.
# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret

# ─── AI Services ───────────────────────────────────────────────────────────────
# Google Generative AI (Gemini) API key.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Server ────────────────────────────────────────────────────────────────────
# Port the Express API server listens on (default: 5000).
PORT=5000

# Allowed frontend origin for CORS.
# In development this is the Vite dev server URL.
# In production set it to your deployed frontend domain, e.g. https://myapp.example.com
CLIENT_ORIGIN=http://localhost:8080
